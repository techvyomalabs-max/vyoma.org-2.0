# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB. Leave unset for local dev — the server automatically falls back to
# an in-memory MongoDB (mongodb-memory-server) so `npm run dev` works with no
# install. Set this for staging/production (MongoDB Atlas connection string).
MONGODB_URI=

# Razorpay (India donations, LLD Section 9). Order creation returns a clear
# "not configured" error until these are set — no fake success is ever
# returned. Use test-mode keys for local/staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CMS "Preview draft" (Phase B) — same value as the Frontend's
# DRAFT_MODE_SECRET. Internal, not a third-party credential.
PREVIEW_SECRET=

# AWS S3 (media uploads). Uploads return a clear "not configured" error until
# these are set — same "no fake success" rule as Razorpay above.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP (LLD Section 8 form notifications, LLD Section 15 "Decisions Required
# Before Development Freeze" — provider is an open decision). If any of these
# are unset, the mailer logs the message instead of sending it.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Auth (Phase 2). Dev-insecure defaults are used if these are unset, EXCEPT in
# production, where the server refuses to boot without them — generate with
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_MFA_TTL=5m
MFA_ISSUER=Vyoma.org Admin

# One-time first-account bootstrap (scripts/bootstrapAuth.js, also runs
# automatically on server startup against an empty/fresh database). Leave
# unset once the first Super Admin exists — there is no other way to create
# it, by design (every other user is created by an existing Super Admin).
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
