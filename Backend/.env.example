# Server
PORT=4000
# NODE_ENV is REQUIRED and must be exactly one of: development, staging,
# production. The server refuses to boot (a fatal startup error, at the very
# first line of configuration loading -- before any database connection,
# seeding, or listening) if this is unset, blank, or any other value. There
# is no fallback default: a staging/production deployment that forgot to set
# this would previously have been silently treated as "development",
# bypassing every environment-gated safety check in this app at once (mock-
# content seeding, the MongoDB persistent-URI requirement below, and the
# production JWT-secret requirement further down) -- confirmed as a material
# risk during staging-readiness review, now closed.
#
# For LOCAL DEVELOPMENT ONLY, without a full .env setup, you may instead
# leave NODE_ENV unset and set ALLOW_LOCAL_DEV_DEFAULTS=true -- this is the
# ONLY way to boot with NODE_ENV unset, and it has no effect at all once
# NODE_ENV is set to anything (valid or not). Never set this in a staging or
# production environment, since those must declare their mode explicitly.
NODE_ENV=development
ALLOW_LOCAL_DEV_DEFAULTS=
CORS_ORIGIN=http://localhost:3000

# MongoDB. Leave unset for local dev only — the server automatically falls
# back to an in-memory MongoDB (mongodb-memory-server) so `npm run dev` works
# with no install. REQUIRED outside local development (NODE_ENV anything
# other than "development"): the server refuses to boot (a fatal startup
# error, not a silent fallback) if this is missing, empty, or whitespace-only
# — an ephemeral in-memory database in staging/production would appear to
# work while losing all data on the next restart. Set this to a real MongoDB
# Atlas connection string for staging/production.
MONGODB_URI=

# Controls whether the server auto-seeds the Frontend's placeholder mock
# content (pages/about, donate, etc.) when the Content collection is
# completely empty. Defaults to ON in development (NODE_ENV unset or
# "development") and OFF in staging (any other NODE_ENV value) and
# production, so a brand-new database is never silently populated with
# placeholder content the first time the server connects to it. Leave unset
# in staging unless you specifically want the mock dataset there, or set to
# "true" to explicitly opt in; set to "false" to opt a local dev environment
# OUT of auto-seeding instead.
#
# PRODUCTION IS AN ABSOLUTE FLOOR: when NODE_ENV=production, mock-content
# seeding is ALWAYS disabled, with no override — setting this to "true" has
# no effect in production. See Backend/STAGING.md for the full first-boot
# checklist.
ALLOW_MOCK_CONTENT_SEED=

# Razorpay (India donations, LLD Section 9). Order creation returns a clear
# "not configured" error until these are set — no fake success is ever
# returned. Use test-mode keys for local/staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CMS "Preview draft" (Phase B) — same value as the Frontend's
# DRAFT_MODE_SECRET. Internal, not a third-party credential.
PREVIEW_SECRET=

# AWS S3 (media uploads). Uploads return a clear "not configured" error until
# these are set — same "no fake success" rule as Razorpay above.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP (LLD Section 8 form notifications, LLD Section 15 "Decisions Required
# Before Development Freeze" — provider is an open decision). All five of
# these (including SMTP_FROM) must be set for the mailer to attempt a real
# send; if any one is unset, it logs the message instead of sending it.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Auth (Phase 2). Dev-insecure defaults are used if these are unset, EXCEPT in
# production, where the server refuses to boot without them — generate with
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_MFA_TTL=5m
MFA_ISSUER=Vyoma.org Admin

# One-time first-account bootstrap (scripts/bootstrapAuth.js, also runs
# automatically on server startup against an empty/fresh database). Leave
# unset once the first Super Admin exists — there is no other way to create
# it, by design (every other user is created by an existing Super Admin).
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
